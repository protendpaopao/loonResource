#!name = 网易大神圈子签到
#!desc = 先抓包保存手动签到请求, 再每天定时重放。v2 只认精确的签到接口 /v1/exp/user/square/signIn, 必须带 GL-CheckSum 才保存, 成功以 completeStatus 为准。
#!author = protendpaopao
#!homepage = https://nsloon.app/docs/Plugin/
#!date = 2026-11-25
#!tag = 签到,网易大神
#!type = normal
#!loon_version = 3.5.1(983)

[Argument]
cronTime = input,"10 8 * * *",type=string,tag=签到时间,desc=Cron 表达式: 分 时 日 月 周, 默认每天 8:10
autoSignin = switch,true,type=boolean,tag=自动签到,desc=关闭后定时任务会跳过执行, 只抓包不签到

[Script]
request if ${url} ~= /^https:\/\/god-exp\.gameyw\.netease\.com\/v1\/exp\/user\/square\/signIn(\?|$)/ then script("https://raw.githubusercontent.com/protendpaopao/loonResource/main/plugin/dashen-capture.js") with requires_body=true, tag="大神签到抓取"
cron ${cronTime} then script("https://raw.githubusercontent.com/protendpaopao/loonResource/main/plugin/dashen-checkin.js", {${autoSignin}}) with enable=${autoSignin}, tag="大神圈子签到", timeout=300

[Mitm]
hostname = god-exp.gameyw.netease.com
